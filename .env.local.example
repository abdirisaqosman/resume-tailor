# Which provider to use: "anthropic" (default), "openai", or "gemini"
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Required if LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey (free tier, no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
